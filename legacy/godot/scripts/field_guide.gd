var kind:String="training"
var pages:Array=[]
var nav_buttons:Array[Button]=[]
var body:VBoxContainer
var scroll:ScrollContainer
var selected:int=0
func _ready()->void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT);offset_left=48;offset_right=-48;offset_top=38;offset_bottom=-38
	add_theme_stylebox_override("panel",UI.panel(.98))
	pages=ABOUT if kind=="about" else CONTROLS if kind=="controls" else TRAINING
	var box:=VBoxContainer.new();box.add_theme_constant_override("separation",20);add_child(box)
	var top:=HBoxContainer.new();box.add_child(top)
	var title:=UI.heading("Об игре" if kind=="about" else "Управление" if kind=="controls" else "Обучение · справочник",34);title.size_flags_horizontal=Control.SIZE_EXPAND_FILL;top.add_child(title)
	var back:=UI.button("Назад · Esc");back.pressed.connect(func()->void:back_requested.emit());top.add_child(back)
	var row:=HBoxContainer.new();row.add_theme_constant_override("separation",28);row.size_flags_vertical=Control.SIZE_EXPAND_FILL;box.add_child(row)
	var nav:=VBoxContainer.new();nav.custom_minimum_size.x=250;row.add_child(nav)
	for i:int in range(pages.size()):
		var button:=UI.button(pages[i].title);button.custom_minimum_size.y=52;button.add_theme_font_size_override("font_size",14)
		button.pressed.connect(func()->void:select_page(i));nav.add_child(button);nav_buttons.append(button)
	scroll=ScrollContainer.new();scroll.horizontal_scroll_mode=ScrollContainer.SCROLL_MODE_DISABLED;scroll.size_flags_horizontal=Control.SIZE_EXPAND_FILL;row.add_child(scroll)
	body=VBoxContainer.new();body.size_flags_horizontal=Control.SIZE_EXPAND_FILL;body.add_theme_constant_override("separation",17);scroll.add_child(body)
	select_page(0);nav_buttons[0].grab_focus()
func select_page(index:int)->void:
	if index<0 or index>=pages.size():return
	selected=index
	for child:Node in body.get_children():body.remove_child(child);child.queue_free()
	var page:Dictionary=pages[index]
	body.add_child(UI.photo(page.image,250))
	body.add_child(UI.label("%02d / %02d"%[index+1,pages.size()],13,UI.TEAL))
	var heading:=UI.heading(page.title,30);heading.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART;body.add_child(heading)
	_paragraph(page.intro,19,UI.PAPER)
	for detail:Array in page.details:
		_paragraph(detail[0],17,UI.TEAL);_paragraph(detail[1],16,UI.MUTED)
	if not page.keys.is_empty():
		var keys:=GridContainer.new();keys.columns=2;keys.add_theme_constant_override("h_separation",18);keys.add_theme_constant_override("v_separation",10);body.add_child(keys)
		for item:Array in page.keys:
			var card:=PanelContainer.new();card.add_theme_stylebox_override("panel",UI.panel(.6));card.size_flags_horizontal=Control.SIZE_EXPAND_FILL;keys.add_child(card)
			var row:=HBoxContainer.new();row.add_theme_constant_override("separation",16);card.add_child(row)
			row.add_child(UI.label(item[0],15,UI.GOLD))
			var caption:=UI.label(item[1],15);caption.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART;caption.size_flags_horizontal=Control.SIZE_EXPAND_FILL;row.add_child(caption)
	for i:int in range(nav_buttons.size()):nav_buttons[i].add_theme_color_override("font_color",UI.TEAL if i==index else UI.PAPER)
	scroll.scroll_vertical=0
func _paragraph(text:String,size:int,color:Color)->void:
	var label:=UI.label(text,size,color);label.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART;body.add_child(label)
